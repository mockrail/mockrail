{
  "name": "@mockrail/cli",
  "version": "0.1.0",
  "description": "mockrail command line: start the sandbox, advance the clock, simulate deposits, load scenarios, replay events.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mockrail/core": "workspace:*",
    "@mockrail/server": "workspace:*"
  },
  "bin": {
    "mockrail": "./dist/bin.js"
  }
}
