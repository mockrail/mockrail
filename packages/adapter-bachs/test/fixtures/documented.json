  "errors": {
    "source": "https://docs.bachs.io/api-reference/error-reference",
    "requiredFields": ["detail", "error_code"],
    "fieldErrorFields": ["field", "message", "type"],
    "codes": {
      "bad_request": { "status": 400, "error_code": "BAD_REQUEST" },
      "validation_failed": { "status": 400, "error_code": "VALIDATION_ERROR" },
      "unauthorized": { "status": 401, "error_code": "UNAUTHORIZED" },
      "forbidden": { "status": 403, "error_code": "FORBIDDEN" },
      "not_found": { "status": 404, "error_code": "NOT_FOUND" },
      "conflict": { "status": 409, "error_code": "CONFLICT" },
      "idempotency_conflict": { "status": 409, "error_code": "IDEMPOTENCY_CONFLICT" },
      "idempotency_in_progress": { "status": 409, "error_code": "IDEMPOTENCY_IN_PROGRESS" },
      "rate_limited": { "status": 429, "error_code": "TOO_MANY_REQUESTS" },
      "insufficient_balance": { "status": 400, "error_code": "INSUFFICIENT_BALANCE" },
      "quote_expired": { "status": 400, "error_code": "QUOTE_EXPIRED" },
      "recipient_incomplete": { "status": 400, "error_code": "PAYOUT_RECIPIENT_INCOMPLETE" },
      "internal": { "status": 500, "error_code": "INTERNAL_SERVER_ERROR" }
    },
    "reasons": {
      "product_not_found": { "status": 400, "error_code": "PRODUCT_NOT_FOUND" },
      "heterogeneous_price_types": { "status": 422, "error_code": "HETEROGENEOUS_PRICE_TYPES" },
      "subscription_trial_ends_in_paid_period": { "status": 400, "error_code": "SUBSCRIPTION_TRIAL_ENDS_IN_PAID_PERIOD" },
      "destination_pending_review": { "status": 400, "error_code": "DESTINATION_PENDING_REVIEW" }
    }
  },
  "pagination": {
    "source": "https://docs.bachs.io/guides/pagination",
    "listFields": ["items", "pagination"],
    "paginationFields": ["next_cursor", "prev_cursor", "has_more", "limit", "offset", "returned", "total"],
    "defaultLimit": 20,
    "maxLimit": 100,
    "badCursorDetail": "Invalid cursor format. Expected 'cur_<offset>'.",
    "cursorExample": "cur_20"
  },
  "money": {
    "source": "https://docs.bachs.io/api-reference/api-standards",
    "examples": [
      { "minor": 2900, "currency": "USD", "wire": "29.00" },
      { "minor": 7500000, "currency": "NGN", "wire": "75000.00" }
    ]
  },
  "webhooks": {
    "source": "https://docs.bachs.io/guides/webhooks/overview",
    "envelopeFields": ["id", "type", "created_at", "organization_id", "data"],
    "eventIdPrefix": "evt_",
    "signedPayload": "{timestamp}.{raw_body}",
    "headers": ["X-Bachs-Timestamp", "X-Bachs-Signature", "X-Bachs-Signature-V2"],
    "retryableStatuses": [408, 429, 500, 502, 503],
    "nonRetryableStatuses": [301, 400, 401, 404],
    "maxAttempts": 5,
    "retryDelaysMinutes": [1, 5, 15, 60],
    "timeoutSeconds": 10,
    "secretPattern": "^whsec_[0-9a-f]{64}$",
    "endpointIdPattern": "^whe_[0-9a-f]{32}$"
  },
  "events": {
    "source": "https://docs.bachs.io/llms.txt (Events section)",
    "emitted": [
      "checkout.completed",
      "checkout.expired",
      "collection.succeeded",
      "collection.failed",
      "collection.underpaid",
      "customer.subscription.created",
      "customer.subscription.updated",
      "customer.subscription.deleted",
      "invoice.created",
      "invoice.paid",
      "invoice.payment_failed",
      "payout.created",
      "payout.paid",
      "payout.failed",
      "payout_destination.approved",
      "payout_destination.rejected",
      "refund.created",
      "refund.paid",
      "refund.failed",
      "customer.created",
      "customer.updated",
      "account.updated",
      "account.tasks_requested",
      "capability.updated",
      "transfer.created"
    ],
    "payloads": {
      "payout.paid": ["withdrawal_id", "reference", "session_id", "narration", "status", "amount", "currency", "from_currency", "to_currency", "exchange_rate", "to_amount", "withdrawal_fee", "net_from_amount"],
      "refund.created": ["refund_id", "charge_id", "reference", "status", "requested_amount", "refunded_amount", "refund_fee_amount", "fee_bearer", "reason"],
      "transfer.created": ["transfer_id", "source", "destination", "amount", "currency", "description", "metadata", "kind", "source_charge_id", "created_at"],
      "capability.updated": ["account", "capability", "status", "requested", "international"]
    }
  },
